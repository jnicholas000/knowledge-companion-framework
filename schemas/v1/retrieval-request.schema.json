{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-companion.dev/schemas/v1/retrieval-request.schema.json",
  "title": "Retrieval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "query",
    "knowledge_snapshot",
    "filters",
    "limit",
    "requested_at",
    "requested_by"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "query": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "knowledge_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version", "snapshot_id"],
      "properties": {
        "pack_id": {
          "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
        },
        "pack_version": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "kinds", "tags", "record_ids"],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["draft", "accepted", "superseded", "deprecated"]
          }
        },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "requested_at": { "type": "string", "format": "date-time" },
    "requested_by": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/actor"
    },
    "extensions": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/extensions"
    }
  }
}

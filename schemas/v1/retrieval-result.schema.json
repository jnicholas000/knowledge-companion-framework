{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-companion.dev/schemas/v1/retrieval-result.schema.json",
  "title": "Retrieval Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "request_id",
    "knowledge_snapshot",
    "provider",
    "matches",
    "limitations",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "request_id": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "knowledge_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version", "snapshot_id"],
      "properties": {
        "pack_id": {
          "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
        },
        "pack_version": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
        },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "rank", "score", "rationale", "matched_claim_ids"],
        "properties": {
          "record_id": {
            "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "minLength": 10 },
          "matched_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
            }
          },
          "extensions": {
            "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/extensions"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    },
    "completed_at": { "type": "string", "format": "date-time" },
    "extensions": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/extensions"
    }
  }
}

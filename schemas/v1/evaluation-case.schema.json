{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-companion.dev/schemas/v1/evaluation-case.schema.json",
  "title": "Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "input",
    "fixture",
    "expectations",
    "evaluator_method",
    "rubric",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 20 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "mode", "audience"],
      "properties": {
        "query": { "type": "string", "minLength": 3 },
        "mode": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["explain", "compare", "trace", "debug", "estimate", "plan"]
            },
            {
              "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/extensionEnum"
            }
          ]
        },
        "audience": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version", "snapshot_id", "record_ids"],
      "properties": {
        "pack_id": {
          "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
        },
        "pack_version": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_behaviors", "prohibited_behaviors"],
      "properties": {
        "required_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "prohibited_behaviors": {
          "type": "array",
          "items": { "type": "string", "minLength": 10 }
        },
        "required_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "evaluator_method": {
      "type": "string",
      "enum": ["deterministic", "rubric", "human", "model_assisted", "hybrid"]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "pass_threshold"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "provenance": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/provenance"
    },
    "extensions": {
      "$ref": "https://knowledge-companion.dev/schemas/v1/common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "dimensionName": {
      "type": "string",
      "enum": [
        "knowledge_quality",
        "reasoning_quality",
        "retrieval_quality",
        "mission_quality",
        "estimation_quality",
        "freshness",
        "coverage",
        "evidence"
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weight", "criteria"],
      "properties": {
        "name": { "$ref": "#/$defs/dimensionName" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "criteria": { "type": "string", "minLength": 10 }
      }
    }
  }
}
